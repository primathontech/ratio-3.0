{
  "name": "ratio-3.0",
  "private": true,
  "version": "0.0.1",
  "description": "Ratio 3.0 — multi-tenant storefront platform (S2 vertical slice: Cloudflare edge + Hono origin + Postgres)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down -v",
    "migrate": "node --env-file-if-exists=apps/origin/.env --import tsx scripts/migrate.ts",
    "seed": "node --env-file-if-exists=apps/origin/.env --import tsx scripts/seed.ts",
    "db:init": "bun run migrate && bun run seed",
    "start": "node --env-file-if-exists=apps/origin/.env --import tsx dev/server.ts",
    "admin-api": "node --env-file-if-exists=apps/admin-api/.env --import tsx apps/admin-api/src/server.ts",
    "gen:client": "tsx scripts/gen-client.ts",
    "prove": "node --env-file-if-exists=apps/origin/.env --import tsx tests/prove.ts",
    "prove:s1": "node --env-file-if-exists=apps/origin/.env --import tsx tests/prove-s1.ts",
    "onboard": "node --env-file-if-exists=apps/origin/.env --import tsx scripts/onboard.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:coverage": "DATABASE_URL=\"${TEST_DATABASE_URL:-postgres://localhost:5432/s2poc_test}\" node --import tsx --import ./tests/bootstrap.ts --test --experimental-test-coverage \"packages/**/*.test.ts\" \"apps/admin-api/**/*.test.ts\" \"apps/origin/**/*.test.ts\" \"apps/edge/**/*.test.ts\" \"tests/e2e/**/*.test.ts\"",
    "cf:dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "prepare": "husky",
    "test:setup": "bun run typecheck && tsx scripts/ensure-test-db.ts && DATABASE_URL=\"${TEST_DATABASE_URL:-postgres://localhost:5432/s2poc_test}\" bun run migrate && DATABASE_URL=\"${TEST_DATABASE_URL:-postgres://localhost:5432/s2poc_test}\" bun run seed",
    "test": "bun run test:setup && DATABASE_URL=\"${TEST_DATABASE_URL:-postgres://localhost:5432/s2poc_test}\" node --import tsx --import ./tests/bootstrap.ts --test \"packages/**/*.test.ts\" \"apps/admin-api/**/*.test.ts\" \"apps/origin/**/*.test.ts\" \"apps/edge/**/*.test.ts\" \"tests/e2e/**/*.test.ts\""
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{tsx,md,json,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@clerk/backend": "^3.11.4",
    "@hono/node-server": "^2.0.10",
    "@neondatabase/serverless": "^1.1.0",
    "@shopkit/data-layer": "^1.3.0",
    "hono": "^4.12.31",
    "liquidjs": "^10.27.2",
    "pg": "^8.13.1",
    "tldts": "^7.4.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.5",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "wrangler": "^4.112.0"
  }
}
