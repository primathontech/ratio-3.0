# @ratio/observability-tracing is a library — no environment of its own, never reads process.env.
# The consuming app injects config to initTracing({ service, endpoint, headers }); typically from:
#   OTEL_EXPORTER_OTLP_ENDPOINT=https://ingest.<region>.signoz.cloud:443   # unset → tracing OFF
#   OTEL_EXPORTER_OTLP_HEADERS=signoz-ingestion-key=<key>                  # key=value,key=value
