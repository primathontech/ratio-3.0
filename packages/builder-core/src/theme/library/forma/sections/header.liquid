<div class="topbar">Free shipping over ₹999 · Extra 10% off your first order</div>
<header class="hdr"><div class="rt hdr-in">
  <a class="hdr-brand" href="/">{{ site_name | default: 'Forma' | escape }}</a>
  <nav class="hdr-nav">
    {% if menu.size > 0 %}{% for item in menu %}{% if item.items.size > 0 %}<div class="nav-item"><a class="navlink" href="{{ item.href | escape }}"{% if item.external %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ item.title | escape }}</a><div class="nav-drop"><ul>{% for l in item.items %}<li><a href="{{ l.href | escape }}"{% if l.external %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ l.title | escape }}</a></li>{% endfor %}</ul></div></div>{% else %}<a class="navlink" href="{{ item.href | escape }}"{% if item.external %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ item.title | escape }}</a>{% endif %}{% endfor %}{% endif %}
  </nav>
  <div class="hdr-actions">
    <a class="hdr-search" href="/search"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.5" y2="16.5"></line></svg>Search products…</a>
    <a class="icon-link" href="/account" aria-label="Account"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"></circle><path d="M5 20c0-3.9 3.1-7 7-7s7 3.1 7 7"></path></svg></a>
    <a class="icon-link" href="/cart" aria-label="Cart"><svg viewBox="0 0 24 24"><path d="M6 8h12l1 12H5L6 8z"></path><path d="M9 8V6a3 3 0 0 1 6 0v2"></path></svg><span class="count">{{ cart_count | default: 0 }}</span></a>
  </div>
</div></header>
