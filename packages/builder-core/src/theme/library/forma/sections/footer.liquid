<footer class="ftr">
  <div class="ftr-in">
    <div class="ftr-col">
      <a class="ftr-brand" href="/">{{ site_name | default: 'Forma' | escape }}</a>
      <p class="ftr-about">Quality products at fair prices, delivered fast across India.</p>
    </div>
    {% if footer.size > 0 %}{% for col in footer %}<div class="ftr-col"><span class="ftr-col-h">{{ col.title | escape }}</span>{% if col.items.size > 0 %}<ul>{% for l in col.items %}<li><a href="{{ l.href | escape }}"{% if l.external %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ l.title | escape }}</a></li>{% endfor %}</ul>{% endif %}</div>{% endfor %}{% endif %}
  </div>
  <div class="ftr-legal">
    <span>© {{ site_name | default: 'Forma' | escape }} · powered by Ratio</span>
    <span>UPI · Cards · Net banking · COD</span>
  </div>
</footer>
