<section class="rt sec">
  <div class="sec-head"><h2>{{ heading | default: 'Shop by Category' | escape }}</h2></div>
  <div class="blocks">
    {% for c in collections %}
    {% assign img = c.image_url | default: c.image.src | default: c.image.url %}
    <a class="block" href="/collections/{{ c.handle | escape }}">
      {% if img %}<img src="{{ img | escape }}" alt="{{ c.title | escape }}">{% endif %}
      <div class="lbl"><b>{{ c.title | escape }}</b><span>Shop now</span></div>
    </a>
    {% endfor %}
  </div>
</section>
