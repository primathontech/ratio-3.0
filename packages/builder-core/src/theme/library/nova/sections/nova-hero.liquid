<section class="nova-hero rt">
  {% if kicker %}<span class="nova-tag">{{ kicker | escape }}</span>{% endif %}
  <h1>{{ heading | escape }}</h1>
  {% if subheading %}<p>{{ subheading | escape }}</p>{% endif %}
  <div class="nova-cta-row">
    {% if cta_label %}<a class="btn" href="{{ cta_href | default: '/collections/all' | escape }}">{{ cta_label | escape }} →</a>{% endif %}
    {% if cta2_label %}<a class="btn btn-dark" href="{{ cta2_href | default: '/collections/all' | escape }}">{{ cta2_label | escape }}</a>{% endif %}
  </div>
  <div class="nova-hero-media">{% if image_url %}<img src="{{ image_url | escape }}" alt="{{ heading | escape }}">{% else %}<span class="stamp">{{ stamp | default: 'NOVA' | escape }}</span>{% endif %}</div>
</section>
