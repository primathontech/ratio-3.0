<main class="rt coll">
  <div class="coll-head">
    <span class="eyebrow">Collections</span>
    <h1>{{ heading | default: 'Collections' | escape }}</h1>
    {% if subheading %}<p>{{ subheading | escape }}</p>{% endif %}
  </div>
  <div class="grid">
    {% for c in collections %}
    {% assign img = c.image_url | default: c.image.src | default: c.image.url %}
    <div class="card">
      <a class="card-link" href="/collections/{{ c.handle | escape }}">
        <div class="ph">{% if img %}<img src="{{ img | escape }}" alt="{{ c.title | escape }}">{% endif %}</div>
        <div class="card-name">{{ c.title | escape }}</div>
      </a>
    </div>
    {% endfor %}
  </div>
</main>
