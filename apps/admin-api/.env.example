RATIO_LOCAL=true
DATABASE_URL=postgres://poc:poc@localhost:5433/poc
EDGE_PORT=8080
EDGE_SECRET=change-me
COMMERCE_PRODUCT_API_URL=
COMMERCE_CART_API_URL=
COMMERCE_ORDER_API_URL=
WEBHOOK_SECRET=
# CLERK_SECRET_KEY=   # prod only; local uses the RATIO_LOCAL dev bypass

# Theme bundle store (OFCE-601 theme code editor). Unset ⇒ the /theme/bundle/* endpoints return 503
# and the Theme code page shows "not enabled". Point at local MinIO (docker compose up -d minio) to
# enable it. The bucket must already exist (the console is at http://localhost:9001, poc / poc12345).
BUNDLE_S3_BUCKET=s2poc-dev
BUNDLE_S3_ENDPOINT=http://localhost:9000
BUNDLE_S3_KEY=poc
BUNDLE_S3_SECRET=poc12345
BUNDLE_S3_REGION=us-east-1
