# Storefront origin — the sole renderer. For local dev, leave the COMMERCE_* and GOKWIK_* values
# BLANK: the origin renders StubResolver sample products with the GoKwik widgets off. Fill them in
# to fetch real data + enable checkout/side-cart (a tenant then also needs commerce.merchantId).
RATIO_LOCAL=true
DATABASE_URL=postgres://poc:poc@localhost:5433/poc
EDGE_SECRET=change-me

# Commerce data APIs (@shopkit/data-layer custom adapter) — PLATFORM-global base URLs, one GoKwik
# backend for every merchant. Per-merchant merchantId lives on the tenant record (tenants.commerce),
# NOT here. All three product/cart/order are required together, or the origin uses the StubResolver.
COMMERCE_PRODUCT_API_URL=
COMMERCE_CART_API_URL=
COMMERCE_ORDER_API_URL=
COMMERCE_NAV_API_URL=          # serves BOTH the header and the footer menu (same base)

# GoKwik widgets. Each widget needs ALL of its fields or it stays off (the strict no-JS default).
GOKWIK_ENVIRONMENT=            # production | sandbox — shared by checkout + side-cart
GOKWIK_BASE_SCRIPT_URL=        # core GoKwik SDK (checkout), e.g. https://pdp.gokwik.co
GOKWIK_SIDECART_SCRIPT_URL=    # KwikCart side-cart drawer script (…/side-cart-os.js)
GOKWIK_CURRENCY=              # e.g. INR
GOKWIK_CURRENCY_FORMAT=       # e.g. en-IN
