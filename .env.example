# Copy to .env and adjust. Local dev needs almost nothing — the code already defaults to the
# docker Postgres and local ports. RATIO_LOCAL just flips on the dev conveniences.

# RATIO_LOCAL=true marks a developer machine: it enables the dev Clerk bypass so the admin API
# runs without a Clerk secret. Unset = staging/prod (the safe default). It NEVER takes effect
# when NODE_ENV=production, so it is harmless even if it leaks into a deployed environment.
# RATIO_LOCAL=true

# Postgres. Defaults to the docker DB (`bun run db:up`) if unset.
# DATABASE_URL=postgres://poc:poc@localhost:5433/poc

# Commerce backend (@shopkit/data-layer custom adapter). These are PLATFORM-global service base URLs
# (one gokwik backend for every merchant). Per-merchant merchantId/storeId live on the tenant record
# (tenants.commerce), NOT here. Leave these UNSET locally to use the StubResolver (sample products);
# set them to fetch real data (a tenant then needs commerce.merchantId + real store data).
# COMMERCE_NAV_API_URL serves BOTH the header and footer menus (same base, different sub-path).
# COMMERCE_PRODUCT_API_URL=https://gkx.gokwik.co/ps
# COMMERCE_CART_API_URL=https://gkx.gokwik.co/os
# COMMERCE_ORDER_API_URL=https://gkx.gokwik.co/cs
# COMMERCE_NAV_API_URL=https://gkx.gokwik.co/pc

# COMMERCE_PRODUCT_API_URL=https://api-gw-v4.dev.gokwik.io/sandbox/pi/ps
# COMMERCE_CART_API_URL=https://api-gw-v4.dev.gokwik.io/sandbox/pi/os
# COMMERCE_ORDER_API_URL=https://api-gw-v4.dev.gokwik.io/sandbox/pi/cs
# COMMERCE_NAV_API_URL=https://api-gw-v4.dev.gokwik.io/sandbox/pi/pc

# GoKwik widgets (checkout SDK + side-cart drawer). Each widget needs ALL of its fields or it stays
# off (strict no-JS default). Per-merchant merchantId comes from the tenant record, not here.
# GOKWIK_ENVIRONMENT=production
# GOKWIK_BASE_SCRIPT_URL=https://pdp.gokwik.co
# GOKWIK_SIDECART_SCRIPT_URL=https://kwikcart.gokwik.co/kwikcart/side-cart-os.js
# GOKWIK_CURRENCY=INR
# GOKWIK_CURRENCY_FORMAT=en-IN

# Commerce webhook (gokwik → cache invalidation, POST /webhooks/commerce). When set, incoming
# webhooks MUST carry a valid x-webhook-signature (HMAC-SHA256 of the raw body). Unset = no
# signature check (local dev).
# WEBHOOK_SECRET=change-me


# NEXT_PUBLIC_CUSTOM_API_PRODUCT_URL=https://gkx.gokwik.co/ps
# NEXT_PUBLIC_CUSTOM_API_CART_URL=https://gkx.gokwik.co/os
# NEXT_PUBLIC_CUSTOM_API_CUSTOMER_URL=https://gkx.gokwik.co/cs

# NEXT_PUBLIC_CUSTOM_API_PRODUCT_URL=https://api-gw-v4.dev.gokwik.io/sandbox/pi/ps
# NEXT_PUBLIC_CUSTOM_API_CART_URL=https://api-gw-v4.dev.gokwik.io/sandbox/pi/os
# NEXT_PUBLIC_CUSTOM_API_CUSTOMER_URL=https://api-gw-v4.dev.gokwik.io/sandbox/pi/cs
